{
  "name": "gnito",
  "version": "0.1.0",
  "description": "Gnito — Your AI. Your Machine. Your Rules. A local-first, self-hosted AI workspace with BYOK providers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "argon2": "0.40.3",
    "better-sqlite3": "11.10.0",
    "chalk": "5.6.2",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "express": "4.22.3",
    "highlight.js": "11.12.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.57.0",
    "marked": "12.0.2",
    "node-cron": "4.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "simple-icons": "^16.35.0",
    "ua-parser-js": "1.0.41",
    "wouter": "3.13.0",
    "zod": "3.23.8",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "8.2.2",
    "eslint": "8.57.1",
    "tsx": "4.23.15",
    "typescript": "5.5.4",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
