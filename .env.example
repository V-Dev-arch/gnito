# Gnito — non-secret configuration only. Never put API keys in here.
# Copy to .env and edit as needed.

# Where Gnito stores its data (default: ~/.gnito)
# GNITO_DATA_DIR=/home/you/.gnito

# Host to bind (default: 127.0.0.1 — loopback only, do not expose to network without understanding the risk)
# GNITO_HOST=127.0.0.1

# Port (default: 8377)
# GNITO_PORT=8377

# Optional: 64-char hex master key for the secrets vault.
# If unset, a random key is generated and stored (mode 0600) at
# $GNITO_DATA_DIR/.gnito-master-key. Set this only if you manage the key
# yourself (e.g., from an OS keychain agent).
# GNITO_MASTER_KEY=<64 hex chars>

# Enable debug logging (default: 0)
# GNITO_DEBUG=0
